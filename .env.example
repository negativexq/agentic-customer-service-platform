APP_NAME=Agentic Customer Service Platform
APP_ENV=development
DEBUG=false
# LOCAL DEMO ONLY: deterministic, non-secret localhost credential. Replace this entire
# auth mode for production; never reuse this value as a production credential.
AUTH_MODE=local_demo
LOCAL_DEMO_AUTH_TOKEN=local-demo-support-token
LOCAL_DEMO_ACTOR_ID=operator-local-demo
# Frontend auth mode: local_demo for localhost only; integration is Compose/CI-only;
# production must use external_session with a trusted session/BFF integration.
FRONTEND_AUTH_MODE=local_demo
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/customer_service
LLM_MODEL=llama3.1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
# Backend containers use this address to reach an OpenAI-compatible LLM on the host.
COMPOSE_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0
# Optional OpenAI-compatible override: none, low, medium, or high. Unset preserves provider defaults.
LLM_REASONING_EFFORT=
# Structured transport: schema preserves the existing path; function_calling uses one synthetic decision tool.
LLM_STRUCTURED_OUTPUT_MODE=schema
# Default runtime contract. direct_tool_v1 remains available only as an explicit compatibility mode.
AGENT_DECISION_CONTRACT_VERSION=semantic_decision_v3
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_TIMEOUT_SECONDS=30.0
CONFIRMATION_TTL_SECONDS=300
RAG_BACKEND=qdrant
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=32
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_CONNECT_TIMEOUT_SECONDS=5.0
EMBEDDING_TIMEOUT_SECONDS=30.0
RERANKER_ENABLED=true
QDRANT_URL=http://localhost:6333
# Logical alias resolved to immutable versioned snapshot collections.
QDRANT_COLLECTION=customer_service_knowledge
QDRANT_SCHEMA_VERSION=2
QDRANT_CHUNKING_VERSION=1
RAG_DENSE_TOP_K=8
RAG_SPARSE_TOP_K=8
RAG_RERANK_CANDIDATES=12
RAG_FINAL_CONTEXT_COUNT=4
RAG_CHUNK_SIZE=800
RAG_RERANKER_TIMEOUT_SECONDS=3.0
QDRANT_TIMEOUT_SECONDS=10.0
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-customer-service-platform
# Opt-in domain metric pipeline; native HTTP binding and deployment are later T4 packages.
# The metric endpoint is independent of the trace/Jaeger endpoint and required when enabled.
OTEL_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=15000
OTEL_METRIC_EXPORT_TIMEOUT_MILLIS=5000

# Optional Compose metrics infrastructure (--profile metrics). Does not enable recording.
COMPOSE_OTEL_METRICS_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
MEMORY_ENABLED=true
MEMORY_MAX_CONTEXT_ITEMS=5
MEMORY_DEFAULT_TTL_DAYS=365
MEMORY_SUPPORT_CONTEXT_TTL_DAYS=30
RESILIENCE_ENABLED=true
RESILIENCE_MAX_RETRIES=2
RESILIENCE_INITIAL_BACKOFF_MS=100
RESILIENCE_MAX_BACKOFF_MS=500
RESILIENCE_JITTER_RATIO=0.2
RESILIENCE_RETRY_BUDGET_ATTEMPTS=100
RESILIENCE_RETRY_BUDGET_WINDOW_SECONDS=60
RESILIENCE_MAX_RETRY_AFTER_SECONDS=30
RESILIENCE_CIRCUIT_FAILURE_THRESHOLD=5
RESILIENCE_CIRCUIT_RECOVERY_SECONDS=30
RESILIENCE_CIRCUIT_HALF_OPEN_ATTEMPTS=1
RESILIENCE_BULKHEAD_DEFAULT_LIMIT=32
RESILIENCE_BULKHEAD_PROVIDER_LIMIT=8
RESILIENCE_BULKHEAD_WAIT_SECONDS=0
RESILIENCE_PRINCIPAL_RATE_LIMIT=600
RESILIENCE_CUSTOMER_RATE_LIMIT=600
RESILIENCE_PROVIDER_RATE_LIMIT=600
RESILIENCE_RATE_LIMIT_WINDOW_SECONDS=60
RETRIEVAL_TIMEOUT_SECONDS=5.0
TOOL_TIMEOUT_SECONDS=10.0
DATABASE_CONNECT_TIMEOUT_SECONDS=5.0
DATABASE_QUERY_TIMEOUT_SECONDS=10.0
DATABASE_POOL_TIMEOUT_SECONDS=5.0
# Used only by explicit AUTH_MODE=static compatibility/test deployments. Production
# settings reject static bearer authentication and require OIDC.
AUTH_TOKENS_JSON={}
# Production uses AUTH_MODE=oidc through docker-compose.prod.yml. These public
# identity-provider coordinates are configuration, not secrets. JWKS is discovered
# from the issuer unless OIDC_DISCOVERY_URL is set by the deployment environment.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_DISCOVERY_URL=
OIDC_ALGORITHM=RS256
OIDC_ROLES_CLAIM=roles
OIDC_GROUPS_CLAIM=groups
OIDC_TENANT_CLAIM=tenant_id
OIDC_CUSTOMER_SCOPE_CLAIM=customer_ids
OIDC_REQUIRE_TENANT=true
OIDC_REQUIRE_CUSTOMER_SCOPE=true
CHECKPOINT_BACKEND=postgres
# Policy audit is durable in PostgreSQL for production/integration. Memory is bounded and test-only.
POLICY_AUDIT_BACKEND=postgres
POLICY_AUDIT_MEMORY_LIMIT=500
POLICY_AUDIT_QUERY_LIMIT=50
# Operator run history is a durable PostgreSQL read model in Compose/integration/production.
AGENT_RUN_PROJECTION_BACKEND=postgres
AGENT_RUN_PROJECTION_MEMORY_LIMIT=500
AGENT_RUN_PROJECTION_QUERY_LIMIT=50
# Strict reconstruction is the default for local Compose and is mandatory in integration/production.
LANGGRAPH_STRICT_MSGPACK=true
